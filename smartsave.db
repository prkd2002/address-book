-- =====================================
-- Views für häufige Abfragen
-- =====================================

-- View für Umsätze mit Kategorien
CREATE VIEW v_kontoumsaetze_mit_kategorien AS
SELECT 
    k.*,
    kat.name as kategorie_name
FROM kontoumsaetze k
LEFT JOIN kategorien kat ON k.kategorie_id = kat.id;

-- View für Einzelumsätze mit Kategorien
CREATE VIEW v_einzelumsaetze_mit_kategorien AS
SELECT 
    e.*,
    kat.name as kategorie_name
FROM einzelumsaetze e
LEFT JOIN kategorien kat ON e.kategorie_id = kat.id;

-- View für Sparziel-Übersicht
CREATE VIEW v_sparziele_uebersicht AS
SELECT 
    s.*,
    b.iban as auszahlungskonto_iban,
    sp.iban as zielkonto_iban,
    COALESCE(SUM(se.betrag), 0) as bisher_gespart,
    s.zielbetrag - COALESCE(SUM(se.betrag), 0) as noch_zu_sparen,
    ROUND((COALESCE(SUM(se.betrag), 0) * 100.0 / s.zielbetrag), 2) as fortschritt_prozent
FROM sparziele s
LEFT JOIN bankkonto b ON s.auszahlungskonto_id = b.id
LEFT JOIN sparkonto sp ON s.zielkonto_id = sp.id
LEFT JOIN sparziel_einzahlungen se ON s.id = se.sparziel_id
GROUP BY s.id, b.iban, sp.iban;

-- View für Dashboard-Daten
CREATE VIEW v_dashboard AS
SELECT 
    'BANK' as konto_typ,
    b.aktueller_saldo,
    b.iban,
    b.bemerkung
FROM bankkonto b
UNION ALL
SELECT 
    'KREDIT' as konto_typ,
    k.aktueller_saldo,
    k.iban,
    k.bemerkung
FROM kreditkartenkonto k;